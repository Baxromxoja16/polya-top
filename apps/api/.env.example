# Nusxa oling: cp .env.example .env
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# docker compose'dagi replica set. Hostdan ulanishda directConnection=true shart
# (RS a'zosi konteyner ichida "mongo:27017" nomi bilan ro'yxatdan o'tgan).
MONGO_URI=mongodb://localhost:27017/polya?directConnection=true
REDIS_URL=redis://localhost:6379

# --- Telegram bot ---
# off      — bot ulanmaydi (faqat API)
# polling  — lokal ishlab chiqish: BotFather token yetarli, ochiq URL kerak emas
# webhook  — produksiya: TELEGRAM_WEBHOOK_SECRET va https PUBLIC_URL shart
TELEGRAM_MODE=polling
TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=   # 32-256 belgi: A-Z a-z 0-9 _ -   (openssl rand -hex 32)
# PUBLIC_URL=https://api.polya.top

# Platforma adminlari (vergul bilan). O'z ID'ingizni @userinfobot orqali bilib oling.
ADMIN_TELEGRAM_IDS=

# Xabarnomalar: queue (BullMQ, produksiya) | direct (darhol)
NOTIFICATIONS_MODE=queue
# Muddati o'tgan so'rovlar va tugagan o'yinlar tekshiruvi (soniya), 0 — o'chiq
BOOKING_SWEEP_SECONDS=60
MARKETING_TICK_SECONDS=60
# Foydalanuvchiga daqiqasiga update'lar limiti (spamga qarshi), 0 — o'chiq
BOT_RATE_LIMIT_PER_MINUTE=30
# Sharh filtri uchun qo'shimcha so'z o'zaklari (vergul bilan)
PROFANITY_EXTRA=
