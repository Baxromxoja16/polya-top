# Nusxa oling: cp .env.example .env
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# docker compose'dagi replica set. Hostdan ulanishda directConnection=true shart
# (RS a'zosi konteyner ichida "mongo:27017" nomi bilan ro'yxatdan o'tgan).
MONGO_URI=mongodb://localhost:27017/polya?directConnection=true
REDIS_URL=redis://localhost:6379
